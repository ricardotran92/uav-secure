  "tuning_knobs": [
    {
      "key": "system.path_loss_log",
      "why": "Defines the shape of the deployment rate map; the single most influential unspecified choice.",
      "tested": [
        {
          "value": "log10",
          "outcome": "flat map, optimum 45-62 m from paper"
        },
        {
          "value": "ln",
          "outcome": "optimum 3-17 m from paper"
        }
      ]
    },
    {
      "key": "system.distance_model",
      "why": "Path-loss distance: 3-D vs horizontal.",
      "tested": [
        {
          "value": "3d",
          "outcome": "optimum 10 m (ln, x-axis) but rate only 2.7 bps/Hz and Fig. 8 profile error 0.35"
        },
        {
          "value": "horizontal",
          "outcome": "optimum 17 m, rate 30 bps/Hz, Fig. 8 profile error 0.15"
        }
      ]
    },
    {
      "key": "system.array_axis",
      "why": "Orientation of the ULA in the horizontal plane (the paper's Fig. 1 does not show it).",
      "tested": [
        {
          "value": "x",
          "outcome": "chosen"
        },
        {
          "value": "y",
          "outcome": "optimum 25 m (ln, horizontal)"
        }
      ]
    },
    {
      "key": "system.noise_power_w",
      "why": "Table I value; SNR level of the whole system.",
      "tested": [
        {
          "value": "1.2e-13",
          "outcome": "Table I, kept"
        },
        {
          "value": "1.2e-10",
          "outcome": "rejected: does not explain Fig. 7/8"
        }
      ]
    },
    {
      "key": "gnn.hidden_dim",
      "why": "Capacity of the GNN; decides how closely its rate map follows the true one.",
      "tested": [
        {
          "value": 128,
          "outcome": "under-fits (71% of OPT)"
        },
        {
          "value": 256,
          "outcome": "72% with constant lr, 81-82% with cosine"
        },
        {
          "value": 512,
          "outcome": "chosen: 84% with cosine"
        },
        {
          "value": 1024,
          "outcome": "collapses at lr 0.005"
        }
      ]
    },
    {
      "key": "gnn.batches_per_epoch",
      "why": "Amount of fresh training data per epoch.",
      "tested": [
        {
          "value": 20,
          "outcome": "see hidden_dim"
        },
        {
          "value": 50,
          "outcome": "chosen"
        }
      ]
    },
    {
      "key": "gnn.grad_clip",
      "why": "Training stability at lr 0.005.",
      "tested": [
        {
          "value": "none",
          "outcome": "collapsed near epoch 125"
        },
        {
          "value": 1.0,
          "outcome": "stable, chosen"
        }
      ]
    },
    {
      "key": "sac.reward_scale",
      "why": "Critic conditioning (reward magnitude about 15-28).",
      "tested": [
        {
          "value": 1.0,
          "outcome": "SAC degraded after about 100 episodes"
        },
        {
          "value": 0.1,
          "outcome": "chosen"
        }
      ]
    },
    {
      "key": "sac.obs_transform",
      "why": "Channel features span decades.",
      "tested": [
        {
          "value": "linear",
          "outcome": "unstable SAC"
        },
        {
          "value": "log",
          "outcome": "chosen"
        }
      ]
    },
    {
      "key": "sac.max_step_m / sac.episode_length",
      "why": "Step size and horizon; decide how directly the UAV can fly to the optimum (the paper's trajectory is straighter than ours).",
      "tested": [
        {
          "value": "5 m / 100",
          "outcome": "20 m from optimum, jitter about 5 m"
        },
        {
          "value": "5 m / 200",
          "outcome": "13.4 m"
        },
        {
          "value": "2.5 m / 100",
          "outcome": "cannot reach the optimum"
        },
        {
          "value": "2.5 m / 200 (1 grad step)",
          "outcome": "56.9 m"
        },
        {
          "value": "2.5 m / 175 (2 grad steps)",
          "outcome": "chosen: 3.9 m, jitter 1.0 m"
        }
      ]
    },
    {
      "key": "eval.search_beamformer",
      "why": "Which beamformer defines the 'optimal' deployment.",
      "tested": [
        {
          "value": "opt",
          "outcome": "reference only"
        },
        {
          "value": "gnn",
          "outcome": "chosen: constraint (24)"
        }
      ]
    },
    {
      "key": "gnn.lr_schedule",
      "why": "Learning-rate schedule (Table I fixes only the value 0.005).",
      "tested": [
        {
          "value": "constant",
          "outcome": "plateau at about 72% of OPT"
